# 1. Copia este archivo y renómbralo a  .env  (con el punto, sin "ejemplo")
# 2. Pega tu cadena de conexión de MongoDB Atlas (Connect -> Drivers -> Python)
#    y reemplaza <db_password> por la contraseña del usuario de la base de datos.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mineria
MONGODB_COLLECTION=mineria_data
